"""Seed test retained and exempt from the mirror rule.

It keeps generated packages' initial test baseline measurable and must not be removed.
"""

from __future__ import annotations


def test_version_is_importable() -> None:
    """The dynamically-generated _version module exposes a version string."""
    from {{ module_name }}._version import __version__

    assert isinstance(__version__, str)
    assert len(__version__) > 0
