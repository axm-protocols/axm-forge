[project]
name = "{{ package_name | replace('_', '-') }}"
version = "0.1.0"
description = "{{ title }}"
readme = "README.md"
requires-python = ">=3.12"
authors = [{ name = "{{ author }}" }]
dependencies = []

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[tool.axm-lab]
kind = "paper"
name = "{{ paper_name }}"
paper = "paper/main.tex"
experiments = "experiments"
