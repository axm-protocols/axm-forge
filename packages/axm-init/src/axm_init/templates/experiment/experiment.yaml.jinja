# Experiment manifest — declared at scaffold time, before any script runs.
#
# axm-init guarantees the structural surface asserted in its own suite: every
# answered key rendered, non-empty, and inside its declared choice set. The
# authoritative round-trip validation against the axm-lab manifest model runs
# in axm-lab's suite — keep both sides in sync when a key is added here.
schema_version: 1
experiment_id: "{{ experiment_id }}"
experiment_title: "{{ experiment_title }}"
research_question: "{{ research_question }}"
experiment_kind: "{{ experiment_kind }}"
reproduction_level: "{{ reproduction_level }}"
paths:
  inputs: inputs
  scripts: scripts
  outputs: outputs
  analysis: analysis
  figures: figures
{%- if experiment_kind == 'hypothesis-testing' %}
  freeze: freeze
{%- endif %}
