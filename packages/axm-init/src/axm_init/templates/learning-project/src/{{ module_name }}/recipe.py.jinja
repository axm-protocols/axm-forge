"""Deterministic, in-memory recipe for the {{ domain }} learning profile."""

from __future__ import annotations

from collections.abc import Iterator

import numpy as np
import torch
from torch import nn
from torch.optim import Optimizer

__all__ = ["SyntheticRecipe"]

type Batch = tuple[torch.Tensor, torch.Tensor]

_FEATURES = 4
_SAMPLES = 64
_SPLIT = 48
_BATCH_SIZE = 8
_DEFAULT_SEED = 17


class SyntheticRecipe:
    """Small linear-regression recipe whose data is fabricated from a seed."""

    def __init__(self, seed: int = _DEFAULT_SEED) -> None:
        self.seed = seed
        generator = np.random.default_rng(seed)
        features = torch.from_numpy(
            generator.normal(size=(_SAMPLES, _FEATURES)).astype(np.float32)
        )
        coefficients = torch.tensor([1.5, -2.0, 0.5, 3.0])
        noise = torch.from_numpy(
            generator.normal(scale=0.01, size=_SAMPLES).astype(np.float32)
        )
        targets = features @ coefficients + noise
        self._train = (features[:_SPLIT], targets[:_SPLIT])
        self._val = (features[_SPLIT:], targets[_SPLIT:])

    def build_model(self) -> nn.Module:
        """Build the linear model owned by this recipe."""
        return nn.Linear(_FEATURES, 1)

    def build_optimizer(self, model: nn.Module) -> Optimizer:
        """Bind the recipe's optimizer to the supplied model."""
        return torch.optim.SGD(model.parameters(), lr=0.05)

    def train_batches(self) -> Iterator[Batch]:
        """Yield deterministic in-memory training batches."""
        yield from self._batches(self._train)

    def val_batches(self) -> Iterator[Batch]:
        """Yield deterministic in-memory validation batches."""
        yield from self._batches(self._val)

    def compute_loss(self, model: nn.Module, batch: Batch) -> torch.Tensor:
        """Compute differentiable mean squared error for one batch."""
        features, targets = batch
        return ((model(features).squeeze(-1) - targets) ** 2).mean()

    @staticmethod
    def _batches(data: Batch) -> Iterator[Batch]:
        features, targets = data
        for start in range(0, len(features), _BATCH_SIZE):
            end = start + _BATCH_SIZE
            yield features[start:end], targets[start:end]
