"""Deterministic, in-memory recipe for the {{ domain }} learning profile."""

from __future__ import annotations

from collections.abc import Iterator, Sequence

import torch
from axm_fit.loss import LossOutput
from axm_fit.preprocessing import StandardizerState
from axm_fit.recipe import RecipeReference, TrainingRecipe
from axm_learning.contracts import FactorySpec, MetricSpec
from torch import nn
from torch.optim import Optimizer

type Batch = tuple[torch.Tensor, torch.Tensor]

_FEATURES = 4
_SAMPLES = 64
_SPLIT = 48
_BATCH_SIZE = 8
_DEFAULT_SEED = 17


class SyntheticRecipe(TrainingRecipe):  # type: ignore[type-arg]
    """Small linear-regression recipe whose data is fabricated from a seed."""

    def __init__(self, seed: int = _DEFAULT_SEED) -> None:
        self.seed = seed
        generator = torch.Generator().manual_seed(seed)
        features = torch.randn(_SAMPLES, _FEATURES, generator=generator)
        coefficients = torch.tensor([1.5, -2.0, 0.5, 3.0])
        noise = 0.01 * torch.randn(_SAMPLES, generator=generator)
        targets = features @ coefficients + noise
        self._train = (features[:_SPLIT], targets[:_SPLIT])
        self._val = (features[_SPLIT:], targets[_SPLIT:])

    @classmethod
    def from_reference(cls, reference: RecipeReference) -> SyntheticRecipe:
        """Rebuild the recipe from its serializable seed option."""
        seed = reference.options.get("seed", _DEFAULT_SEED)
        if not isinstance(seed, int):
            raise TypeError("recipe seed must be an integer")
        return cls(seed=seed)

    def export_reference(self) -> RecipeReference:
        """Describe how to reconstruct this recipe without carrying its data."""
        return RecipeReference(
            import_path=f"{type(self).__module__}.{type(self).__name__}",
            options={"seed": self.seed},
        )

    def build_model(self) -> nn.Module:
        """Build the linear model owned by this recipe."""
        return nn.Linear(_FEATURES, 1)

    def build_optimizer(self, model: nn.Module) -> Optimizer:
        """Bind the recipe's optimizer to the supplied model."""
        return torch.optim.SGD(model.parameters(), lr=0.05)

    def train_batches(self) -> Iterator[Batch]:
        """Yield deterministic in-memory training batches."""
        yield from self._batches(self._train)

    def val_batches(self) -> Iterator[Batch]:
        """Yield deterministic in-memory validation batches."""
        yield from self._batches(self._val)

    def metrics(self) -> Sequence[MetricSpec]:
        """Declare the validation metric read by the engine."""
        return (
            MetricSpec(
                name="mse",
                factory=FactorySpec(target="torchmetrics:MeanSquaredError"),
                direction="minimize",
            ),
        )

    def split_batches(self, split: str) -> Iterator[torch.Tensor]:
        """Yield the raw inputs of a named split."""
        features, _ = self._split(split)
        for start in range(0, len(features), _BATCH_SIZE):
            yield features[start : start + _BATCH_SIZE]

    def predict(
        self,
        model: nn.Module,
        inputs: torch.Tensor,
        *,
        preprocessing: StandardizerState | None = None,
    ) -> torch.Tensor:
        """Predict one scalar per row; this recipe needs no preprocessing."""
        del preprocessing
        with torch.no_grad():
            return model(inputs).squeeze(-1)

    def compute_loss(self, model: nn.Module, batch: Batch) -> LossOutput:
        """Compute mean squared error for one batch."""
        features, targets = batch
        total = ((model(features).squeeze(-1) - targets) ** 2).mean()
        return LossOutput(
            total=total,
            terms={"mse": total},
            num_examples=len(features),
        )

    def _split(self, split: str) -> Batch:
        if split == "train":
            return self._train
        if split == "val":
            return self._val
        raise ValueError(f"unknown split: {split}")

    @staticmethod
    def _batches(data: Batch) -> Iterator[Batch]:
        features, targets = data
        for start in range(0, len(features), _BATCH_SIZE):
            end = start + _BATCH_SIZE
            yield features[start:end], targets[start:end]
