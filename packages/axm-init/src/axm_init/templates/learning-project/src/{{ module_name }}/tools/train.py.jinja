"""Executable training entry point for the generated learning project."""

from __future__ import annotations

import tomllib
from dataclasses import dataclass
from itertools import cycle
from pathlib import Path

import torch
from axm.tools.base import ToolResult

from {{ module_name }}.recipe import SyntheticRecipe

__all__ = ["TrainingOutcome", "TrainingTool", "run_training"]


@dataclass(frozen=True, slots=True)
class TrainingOutcome:
    """Finite losses and update count from one bounded local training run."""

    initial_loss: float
    final_loss: float
    updates: int


def _max_steps(config_path: Path) -> int:
    with config_path.open("rb") as stream:
        document = tomllib.load(stream)
    schedule = document.get("schedule")
    if not isinstance(schedule, dict):
        raise ValueError("training configuration requires a schedule table")
    max_steps = schedule.get("max_steps")
    if not isinstance(max_steps, int) or max_steps <= 0:
        raise ValueError("training configuration requires a positive max_steps")
    return max_steps


def run_training(config_path: Path = Path("training.toml")) -> TrainingOutcome:
    """Train the deterministic in-memory recipe without external I/O."""
    max_steps = _max_steps(config_path)
    torch.manual_seed(17)
    recipe = SyntheticRecipe(seed=17)
    model = recipe.build_model()
    optimizer = recipe.build_optimizer(model)
    batches = cycle(recipe.train_batches())
    initial_loss: float | None = None
    final_loss = 0.0

    for _ in range(max_steps):
        optimizer.zero_grad()
        loss = recipe.compute_loss(model, next(batches))
        value = float(loss.detach().item())
        if initial_loss is None:
            initial_loss = value
        loss.backward()
        optimizer.step()
        final_loss = value

    if initial_loss is None:  # pragma: no cover - max_steps is positive
        raise RuntimeError("training completed without an update")
    return TrainingOutcome(
        initial_loss=initial_loss,
        final_loss=final_loss,
        updates=max_steps,
    )


def _main() -> None:
    outcome = run_training()
    print(f"FINAL_LOSS={outcome.final_loss}")


class TrainingTool:
    """Run one bounded training job from a versioned configuration."""

    @property
    def name(self) -> str:
        """Return the registered tool name."""
        return "{{ module_name }}_train"

    def execute(self, config_path: str = "training.toml") -> ToolResult:
        """Run training and return a structured AXM result."""
        try:
            outcome = run_training(Path(config_path))
        except Exception as exc:
            return ToolResult(success=False, error=str(exc))
        return ToolResult(
            success=True,
            data={
                "initial_loss": outcome.initial_loss,
                "final_loss": outcome.final_loss,
                "updates": outcome.updates,
            },
            text=f"FINAL_LOSS={outcome.final_loss}",
        )


if __name__ == "__main__":
    _main()
