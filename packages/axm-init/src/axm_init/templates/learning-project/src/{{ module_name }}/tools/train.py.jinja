"""AXMTool adapter for the generated learning configuration."""

from __future__ import annotations

from pathlib import Path

from axm.tools.base import ToolResult
from axm_fit.loop import TrainingBudget, TrainingOutcome, train
from axm_fit.recipe import RecipeReference, load_recipe
from axm_learning.config import resolve_training_config

__all__ = ["TrainingTool", "run_training"]


def run_training(config_path: Path = Path("training.toml")) -> TrainingOutcome:
    """Resolve the profile configuration and delegate the run to axm-fit."""
    resolved = resolve_training_config(config_path)
    max_steps = resolved.doc.schedule.max_steps
    if max_steps is None or max_steps <= 0:
        raise ValueError("training configuration requires a positive max_steps")
    reference = RecipeReference(
        import_path=resolved.doc.recipe_ref.entry_point.replace(":", "."),
        options={"seed": 17},
    )
    recipe = load_recipe(reference)
    return train(recipe, TrainingBudget(max_updates=max_steps))


class TrainingTool:
    """Run one bounded training job from a versioned configuration."""

    @property
    def name(self) -> str:
        """Return the registered tool name."""
        return "{{ module_name }}_train"

    def execute(self, config_path: str = "training.toml") -> ToolResult:
        """Run training and return a structured AXM result."""
        try:
            outcome = run_training(Path(config_path))
        except Exception as exc:
            return ToolResult(success=False, error=str(exc))
        return ToolResult(
            success=True,
            data={"outcome": str(outcome)},
            text=f"{{ module_name }}_train | ✓ | {config_path}",
        )
