repetitions = 1

[study]
study_name = "{{ domain }}-synthetic-search"

[search_space]
params = [
  { kind = "float", name = "optimizer.optimizer.params.lr", low = 0.001, high = 0.1, log = true },
]

[budgets]
max_trials = 10
max_concurrent_trials = 1
max_duration_seconds = 600.0
max_failed_trials = 2
max_pruned_trials = 5
max_completed_replicates = 10

[[objectives]]
name = "mse"
direction = "minimize"

[objectives.factory]
target = "torchmetrics:MeanSquaredError"

[training.recipe_ref]
distribution = "{{ package_name or module_name }}"
version = "0.1.0"
entry_point = "{{ module_name }}{% if not package_name %}.learning{% endif %}.recipe:SyntheticRecipe"
contract_version = 1

[training.run]
run_id = "{{ domain }}-synthetic-study"

[training.data.identity]
name = "{{ domain }}-synthetic"
version = "1"

[training.data.loader]
target = "{{ module_name }}{% if not package_name %}.learning{% endif %}.recipe:SyntheticRecipe"
params = { seed = 17 }

[training.data.splits.train]
fractions = { train = 0.8, val = 0.2 }

[training.model.identity]
name = "synthetic-linear"
version = "1"

[training.model.factory]
target = "torch.nn:Linear"
params = { in_features = 4, out_features = 1 }

[training.objective]
direction = "minimize"

[training.objective.loss.factory]
target = "torch.nn:MSELoss"

[training.schedule]
max_steps = 20

[training.optimizer.optimizer]
target = "torch.optim:SGD"
params = { lr = 0.05 }

[[training.metrics]]
name = "mse"
direction = "minimize"

[training.metrics.factory]
target = "torchmetrics:MeanSquaredError"
