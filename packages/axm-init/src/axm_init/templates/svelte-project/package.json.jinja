{
  "name": "{{ package_name }}",
  "version": "0.1.0",
  "description": "{{ description }}",
  "license": "{{ license }}",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/{{ org }}/{{ package_name }}.git"
  },
  "author": "{{ author_name }} <{{ author_email }}>",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "lint": "eslint .",
    "format": "prettier --check .",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "docs": "typedoc",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2",
    "@commitlint/cli": "^19",
    "@commitlint/config-conventional": "^19",
    "@sveltejs/kit": "^2",
    "@sveltejs/vite-plugin-svelte": "^4",
    "eslint": "^9",
    "eslint-plugin-import-x": "^4",
    "eslint-plugin-jsdoc": "^50",
    "eslint-plugin-n": "^17",
    "eslint-plugin-sonarjs": "^3",
    "eslint-plugin-svelte": "^2",
    "husky": "^9",
    "prettier": "^3",
    "prettier-plugin-svelte": "^3",
    "svelte": "^5",
    "svelte-check": "^4",
    "typedoc": "^0.27",
    "typescript": "^5",
    "vite": "^5",
    "vitest": "^2"
  }
}
