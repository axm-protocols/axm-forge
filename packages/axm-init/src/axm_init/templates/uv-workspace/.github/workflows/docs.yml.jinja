name: Publish Docs

on:
  push:
    branches: [main]
{%- if docs_hosting == 'cloudflare' %}
    paths:
      - "docs/**"
      - "mkdocs.yml"
      - "packages/*/docs/**"
      - "packages/*/mkdocs.yml"
      - "wrangler.toml"
  workflow_dispatch:
{%- endif %}

# Declaring any permission resets every other scope to `none`, so `contents`
# has to be spelled out: without it the job cannot even check out its own
# repository when that repository is private ("Repository not found" from
# actions/checkout).
permissions:
  contents: read
{%- if docs_hosting == 'github-pages' %}
  pages: write
  id-token: write
{%- endif %}

concurrency:
  group: "pages"
  cancel-in-progress: false

jobs:
{%- if docs_hosting == 'cloudflare' %}
  deploy:
    runs-on: ubuntu-latest
    environment:
      name: cloudflare-docs
      url: https://{{ docs_domain }}
    steps:
      - uses: actions/checkout@v7
      - uses: astral-sh/setup-uv@v7
      # Both flags are load-bearing for a workspace, and each one alone fails:
      #   - `--group docs` because mkdocs and its plugins live in that
      #     dependency-group, which a default sync does not install
      #     ("Failed to spawn: mkdocs");
      #   - `--all-packages` because mkdocstrings imports every member to build
      #     its API reference, and a sync that omits them prunes them from the
      #     environment ("Could not collect '<module>'").
      - run: uv sync --all-packages --group docs
      - run: uv run mkdocs build
      # Requires CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID as repository
      # secrets, and a DNS record pointing {{ docs_domain }} at the worker.
      - name: Deploy to Cloudflare
        uses: cloudflare/wrangler-action@v4
        with:
          apiToken: {% raw %}${{ secrets.CLOUDFLARE_API_TOKEN }}{% endraw %}
          accountId: {% raw %}${{ secrets.CLOUDFLARE_ACCOUNT_ID }}{% endraw %}
          command: deploy
{%- else %}
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: astral-sh/setup-uv@v7
      # Both flags are load-bearing for a workspace, and each one alone fails:
      #   - `--group docs` because mkdocs and its plugins live in that
      #     dependency-group, which a default sync does not install
      #     ("Failed to spawn: mkdocs");
      #   - `--all-packages` because mkdocstrings imports every member to build
      #     its API reference, and a sync that omits them prunes them from the
      #     environment ("Could not collect '<module>'").
      - run: uv sync --all-packages --group docs
      - run: uv run mkdocs build
      - uses: actions/upload-pages-artifact@v4
        with:
          path: site

  deploy:
    environment:
      name: github-pages
      url: {% raw %}${{ steps.deployment.outputs.page_url }}{% endraw %}
    runs-on: ubuntu-latest
    needs: build
    permissions:
      pages: write
      id-token: write
    steps:
      - uses: actions/deploy-pages@v5
        id: deployment
{%- endif %}
