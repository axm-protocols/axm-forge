site_name: "{{ workspace_name }}"
site_url: "{% if docs_hosting == 'cloudflare' %}https://{{ docs_domain }}{% else %}https://{{ org }}.github.io/{{ workspace_name }}{% endif %}"
repo_url: "https://github.com/{{ org }}/{{ workspace_name }}"
repo_name: {{ org }}/{{ workspace_name }}

theme:
  name: material
  palette:
    - scheme: default
      primary: indigo
      toggle:
        icon: material/brightness-7
        name: Switch to dark mode
    - scheme: slate
      primary: indigo
      toggle:
        icon: material/brightness-4
        name: Switch to light mode
  features:
    - navigation.tabs
    - navigation.sections
    - navigation.indexes
    - navigation.top
    - search.suggest
    - search.highlight
    - content.code.copy

# `monorepo` merges each member's nav into this site but does NOT run the
# plugins that member declares, so the members' own gen-files never fires here
# and nothing would emit the pages their `reference/api/` nav entries point
# at. docs/gen_ref_pages.py regenerates them for the aggregated build, at the
# very path each member uses standalone. Adding a member needs no edit here.
plugins:
  - search
  - monorepo
  - gen-files:
      scripts:
        - docs/gen_ref_pages.py
  - literate-nav:
      nav_file: SUMMARY.md
  # No `paths:` here: the members are installed into the environment by
  # `uv sync --all-packages`, so mkdocstrings imports them by name.
  - mkdocstrings:
      handlers:
        python:
          options:
            docstring_style: google
            show_root_heading: true
            show_root_full_path: false
            heading_level: 3

nav:
  - Home: index.md
